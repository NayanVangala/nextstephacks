{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --prefix src/frontend && npm run build --prefix src/frontend",
  "outputDirectory": "src/frontend/dist",
  "installCommand": "echo skip",
  "framework": null,
  "headers": [
    {
      "source": "/city-packs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
