{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CityPack",
  "type": "object",
  "required": [
    "manifest",
    "nodes",
    "edges"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "bbox",
        "timezone",
        "hour_buckets",
        "generated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "timezone": {
          "type": "string"
        },
        "hour_buckets": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "generated_at": {
          "type": "string"
        },
        "buildings_total": {
          "type": "integer"
        },
        "buildings_assumed_height": {
          "type": "integer"
        },
        "gtfs_static_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transit_stops_total": {
          "type": "integer"
        },
        "transit_stops_accessible": {
          "type": "integer"
        },
        "transit_wheelchair_field_present": {
          "type": "boolean"
        },
        "canceled_service_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lon",
          "lat"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/edge"
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lon",
          "lat",
          "kind",
          "backup_power",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cooling_center",
              "evacuation_center",
              "rest_stop",
              "transit_stop"
            ]
          },
          "backup_power": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "wheelchair_boarding": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        }
      }
    },
    "canceled_service": {
      "type": "object",
      "required": [
        "總",
        "路",
        "更新於"
      ],
      "properties": {
        "總": {
          "type": "integer"
        },
        "路": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "更新於": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "canceled_service_fetched_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "index": {
      "description": "區區之度量。null 者,未算也 —— 非「皆零」。null means NOT COMPUTED, never 'all zero'.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "geoid",
          "節數",
          "總米",
          "可通米",
          "通之率",
          "蔭之率",
          "連之率",
          "入息",
          "入息之誤",
          "界"
        ],
        "properties": {
          "geoid": {
            "type": "string"
          },
          "節數": {
            "type": "integer",
            "minimum": 0
          },
          "總米": {
            "type": "number",
            "minimum": 0
          },
          "可通米": {
            "type": "number",
            "minimum": 0
          },
          "通之率": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "蔭之率": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "連之率": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "入息": {
            "type": [
              "integer",
              "null"
            ]
          },
          "入息之誤": {
            "type": [
              "integer",
              "null"
            ]
          },
          "界": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "index_correlation": {
      "description": "所量之相關,非所斷之言。Measured, not asserted — recomputed every build.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "區之數": {
          "type": "integer"
        },
        "有入息者": {
          "type": "integer"
        },
        "可信者": {
          "type": "integer"
        },
        "誤比之界": {
          "type": "number"
        },
        "蔭與入息": {
          "type": [
            "number",
            "null"
          ]
        },
        "蔭與入息_可信": {
          "type": [
            "number",
            "null"
          ]
        },
        "連與入息": {
          "type": [
            "number",
            "null"
          ]
        },
        "連與入息_可信": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "index_unavailable_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "length_m",
        "geometry",
        "is_steps",
        "is_crossing",
        "confidence",
        "traversable"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "length_m": {
          "type": "number"
        },
        "geometry": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "is_steps": {
          "type": "boolean"
        },
        "step_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "kerb": {
          "type": [
            "string",
            "null"
          ]
        },
        "wheelchair_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "incline_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "width_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "tactile_paving": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_crossing": {
          "type": "boolean"
        },
        "crossing_signalized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sun_exposure": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "traversable": {
          "type": "object",
          "required": [
            "wheelchair",
            "blind_low_vision",
            "heat_sensitive",
            "none"
          ],
          "properties": {
            "wheelchair": {
              "type": "boolean"
            },
            "blind_low_vision": {
              "type": "boolean"
            },
            "heat_sensitive": {
              "type": "boolean"
            },
            "none": {
              "type": "boolean"
            }
          }
        },
        "near_rest_stop": {
          "type": "boolean"
        }
      }
    }
  }
}
